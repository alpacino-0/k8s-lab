# dependencies
node_modules/
.npm

# local secrets — never commit real values
*.secret.yaml
secrets/
.env
.env.*

# build artefacts
coverage/
*.tgz
*.tar
kubeconform
# Go: tool binaries downloaded by Makefile.operator, coverage output, and the
# workspace file — go.work is deliberately absent, see PRODUCT-PLAN's module
# decision: it has no effect on a consumer, which is exactly damga-ee's position.
bin/
*.out
*.test
go.work
go.work.sum
Dockerfile.cross

# editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Development notes — private, not published. DEPLOY.md is the exception: it is
# a runbook for other people, not a working note. The directory has to be
# excluded by contents rather than as a whole, because git does not descend into
# an excluded directory to find a negation.
docs/*
!docs/DEPLOY.md

# Claude Code — local session config, never shared with the repo
.claude/
