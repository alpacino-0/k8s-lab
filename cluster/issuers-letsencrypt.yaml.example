# Let's Encrypt issuers. Copy to issuers-letsencrypt.yaml, set the email, apply.
#
# Rehearse with staging. Let's Encrypt rate-limits failed authorisations hard,
# and the usual cause of failure is DNS that has not propagated yet — which is
# exactly the mistake you want to make against a server that does not count it.
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-staging
spec:
  acme:
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    email: you@example.com        # receives expiry and failure notices
    privateKeySecretRef:
      name: letsencrypt-staging-account
    solvers:
      - http01:
          ingress:
            ingressClassName: nginx
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: you@example.com
    privateKeySecretRef:
      name: letsencrypt-prod-account
    solvers:
      - http01:
          ingress:
            ingressClassName: nginx
